    <string name="app_name">Mimir</string><string name="go_home">返回主页</string><string name="toggle_dark_mode">切换深色模式</string><string name="open_tool">打开%1$s</string>
<string name="home_prompt">从下方列表中选择一个工具开始使用</string>    <string name="goal_fix_multidisc">整理多光盘游戏</string><string name="tool_multidisc">多光盘整理工具</string><string name="tool_multidisc_description">查找分布在多张光盘上的游戏，并为每个游戏创建 .m3u 播放列表，让前端只显示一次该游戏并可切换光盘。对于 ES-DE，还会把光盘移入一个显示为单个游戏的文件夹。</string>
    <string name="goal_create_vita_shortcuts">创建 Vita 快捷方式</string><string name="tool_vita_shortcuts">Vita 快捷方式</string><string name="tool_vita_shortcuts_description">搜索内置的 PS Vita 游戏列表，为已安装在 Vita3K 中的游戏保存 .psvita 或 .dpt 快捷方式，让前端可以显示并启动它。</string>
    <string name="goal_setup_esde">设置 ES-DE</string><string name="tool_esde_systems">ES-DE 系统</string><string name="tool_esde_systems_description">下载适用于 Android 版 ES-DE 的最新社区自定义系统，为每个系统关联 ROM 文件夹，并安装到 ES-DE 的 custom_systems 文件夹。重启 ES-DE 即可加载。</string>
    <string name="goal_convert_switch_packages">转换 Switch 软件包</string><string name="tool_nsz_to_nsp">NSZ 转 NSP</string><string name="tool_nsz_to_nsp_description">将 Switch .nsz 文件解压为完整的 .nsp 包，供无法读取 NSZ 的模拟器使用。需要你自己的 prod.keys。.nsz 文件会保留。</string>
    <string name="goal_compress_cartridge_roms">压缩卡带 ROM</string><string name="tool_romzipper">RomZipper</string><string name="tool_romzipper_description">将每个卡带 ROM（Game Boy、GBA、DS、NES、SNES、N64、Mega Drive 等）分别打包为 .zip 以节省空间。大多数模拟器可以直接打开 zip。未压缩的 ROM 会被删除。</string>
    <string name="goal_compress_disc_images">压缩光盘映像</string><string name="tool_chdman">CHDMan</string><string name="tool_chdman_description">将 PS1、PS2、PSP、Saturn、Dreamcast 和 Sega CD 光盘映像（.cue/.bin、.gdi、.iso）压缩为每个游戏一个 .chd 文件。无损压缩，游戏运行不变，占用空间更小。</string>
    <string name="goal_shrink_gamecube_wii">压缩 GameCube 和 Wii 游戏</string><string name="tool_dolphin_rvz">Dolphin RVZ</string><string name="tool_dolphin_rvz_description">将 GameCube 和 Wii 的 .iso 文件压缩为 Dolphin 的无损格式 .rvz。游戏运行不变，占用空间大幅减少。.iso 文件会保留。</string>
    <string name="goal_shrink_3ds">压缩 Nintendo 3DS 游戏</string><string name="tool_azahar_zcci">Azahar ZCCI</string><string name="tool_azahar_zcci_description">将已解密的 3DS 游戏（.3ds、.cci）压缩为 Azahar 可直接运行的 .zcci。加密的转储无法转换。原始文件会保留。</string><string name="goal_shrink_xbox">压缩 Xbox 游戏</string><string name="tool_xbox_xiso">Xbox XISO</string><string name="tool_xbox_xiso_description">移除 Redump Xbox .iso 文件中未使用的视频分区和填充数据。裁剪后的 XISO 会替换原文件，可在 xemu 和 Hakux 中运行。</string>
    <string name="goal_patch_rom">为 ROM 打补丁</string>
    <string name="tool_rom_patcher">ROM 补丁工具</string>
    <string name="tool_rom_patcher_description">将 IPS、UPS 或 BPS 补丁（如汉化、改版或修正）应用到 ROM，并把打好补丁的副本保存到 ROM 所在的文件夹。原始 ROM 保持不变。</string>    <string name="no_rom_folder_selected">未选择 ROM 文件夹</string><string name="no_vita_output_directory_selected">未选择 Vita 输出文件夹</string><string name="no_esde_folder_selected">未选择 ES-DE 文件夹</string>

