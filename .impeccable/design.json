  "components": [
    {
      "name": "Ink Button",
      "kind": "button",
      "refersTo": "button-ink",
      "description": "Primary forward action on a pane, filled in the page ink (Vita cobalt shown). Focus: 3dp ink ring, lift, and on night a 22% brighter fill.",
      "html": "<button class=\"ds-btn-ink\">Choose folder</button>",
      "css": ".ds-btn-ink{font-family:'Rubik',system-ui,sans-serif;font-size:14px;font-weight:600;letter-spacing:.01em;background:#5B95FF;color:#05070D;border:none;border-radius:9999px;padding:10px 24px;outline:3px solid transparent;outline-offset:3px;transition:transform .25s cubic-bezier(.34,1.56,.64,1),background .15s;}.ds-btn-ink:hover{background:#7aa9ff;}.ds-btn-ink:focus-visible{outline-color:#5B95FF;background:#7aa9ff;transform:scale(1.06) translateY(-2px);}.ds-btn-ink:active{background:#4a82e8;}"
    },
    {
      "name": "Caution Button",
      "kind": "button",
      "refersTo": "button-caution",
      "description": "Only for writes that cannot be taken back: confirm apply/convert, replace output, remove shortcut, stop now.",
      "html": "<button class=\"ds-btn-caution\">Start 12 conversions</button>",
      "css": ".ds-btn-caution{font-family:'Rubik',system-ui,sans-serif;font-size:14px;font-weight:600;letter-spacing:.01em;background:#FFB347;color:#2A1600;border:none;border-radius:9999px;padding:10px 24px;outline:3px solid transparent;outline-offset:3px;transition:transform .25s cubic-bezier(.34,1.56,.64,1),background .15s;}.ds-btn-caution:focus-visible{outline-color:#FFB347;background:#ffc670;transform:scale(1.06) translateY(-2px);}.ds-btn-caution:active{background:#f0a032;}"
    },
    {
      "name": "Outlined Button",
      "kind": "button",
      "refersTo": "button-outlined",
      "description": "Cancel and secondary actions: ink text with a 60% ink outline.",
      "html": "<button class=\"ds-btn-outlined\">Cancel</button>",
      "css": ".ds-btn-outlined{font-family:'Rubik',system-ui,sans-serif;font-size:14px;font-weight:600;background:transparent;color:#7FA7FF;border:1px solid rgba(127,167,255,.6);border-radius:9999px;padding:10px 24px;outline:3px solid transparent;outline-offset:2px;}.ds-btn-outlined:hover{background:rgba(127,167,255,.08);}.ds-btn-outlined:focus-visible{outline-color:#7FA7FF;}"
    },
    {
      "name": "Legend Bar",
      "kind": "nav",
      "refersTo": "legend-bar",
      "description": "Face-button legend along the foot of every screen; drawn glyphs, sentence-case labels, primary action emphasised in ink, disabled at 38%.",
      "html": "<div class=\"ds-legend\"><span class=\"ds-legend-item\"><span class=\"ds-glyph\" style=\"background:#E8EEFF\">A</span>Select</span><span class=\"ds-legend-item\"><span class=\"ds-glyph\" style=\"background:#E8EEFF\">B</span>Back</span><span class=\"ds-legend-item ds-legend-emph\"><span class=\"ds-glyph\" style=\"background:#FF8A3D\">X</span>Scan folder</span><span class=\"ds-legend-item ds-legend-off\"><span class=\"ds-glyph\" style=\"background:#E8EEFF\">Y</span>Apply</span></div>",
      "css": ".ds-legend{font-family:'Rubik',system-ui,sans-serif;display:flex;justify-content:flex-end;gap:8px;background:rgba(17,25,52,.94);padding:2px 16px;min-height:48px;align-items:center;}.ds-legend-item{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 12px;border-radius:9999px;color:#E8EEFF;font-size:14px;font-weight:600;border:1px solid transparent;}.ds-legend-emph{color:#FF8A3D;background:rgba(255,138,61,.18);border-color:rgba(255,138,61,.6);}.ds-legend-off{opacity:.38;}.ds-legend-item:focus-visible{outline:3px solid #FF8A3D;}.ds-glyph{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;color:#05070D;font-weight:800;font-size:12px;}"
    },
    {
      "name": "Save Block",
      "kind": "custom",
      "refersTo": "save-block",
      "description": "A tool as a drawn object in a memory-card slot cell. Focused: ink fill 16%, 3dp ink border, lift, and the object rocks about its vertical axis.",
      "html": "<div class=\"ds-slot\"><button class=\"ds-block\"><span class=\"ds-block-cell\"><svg viewBox=\"0 0 64 64\" width=\"70%\" height=\"70%\" class=\"ds-turn\"><circle cx=\"32\" cy=\"35\" r=\"24\" fill=\"#2a6f45\"/><circle cx=\"32\" cy=\"32\" r=\"24\" fill=\"#4ADE80\"/><path d=\"M14 22a22 22 0 0 1 10-8\" stroke=\"rgba(255,255,255,.5)\" stroke-width=\"2.5\" fill=\"none\" stroke-linecap=\"round\"/><circle cx=\"32\" cy=\"32\" r=\"6\" fill=\"#a8f0c4\"/><circle cx=\"32\" cy=\"32\" r=\"2.4\" fill=\"#111934\"/></svg></span><span class=\"ds-block-name\">Xbox XISO</span></button><span class=\"ds-empty\"></span></div>",
      "css": ".ds-slot{display:flex;gap:10px;background:#05070D;padding:16px;}.ds-block{font-family:'Rubik',system-ui,sans-serif;width:120px;background:none;border:none;padding:0;display:flex;flex-direction:column;align-items:center;gap:4px;cursor:pointer;transition:transform .35s cubic-bezier(.34,1.56,.64,1);}.ds-block-cell{width:120px;aspect-ratio:1;display:flex;align-items:center;justify-content:center;background:#111934;border:1px solid rgba(127,167,255,.22);border-radius:16px;}.ds-block-name{font-size:12px;font-weight:600;letter-spacing:.02em;color:#9AA7CB;}.ds-block:hover .ds-block-cell,.ds-block:focus-visible .ds-block-cell{background:rgba(74,222,128,.16);border:3px solid #4ADE80;}.ds-block:focus-visible{outline:none;transform:scale(1.06) translateY(-4px);}.ds-block:focus-visible .ds-block-name{color:#E8EEFF;}.ds-block:focus-visible .ds-turn{animation:ds-rock 1.8s ease-in-out infinite alternate;}@keyframes ds-rock{from{transform:perspective(300px) rotateY(-18deg)}to{transform:perspective(300px) rotateY(18deg)}}@media (prefers-reduced-motion:reduce){.ds-block:focus-visible .ds-turn{animation:none}}.ds-empty{width:120px;aspect-ratio:1;border:1.5px dashed #1B2650;border-radius:16px;}"
    },
    {
      "name": "Console Panel",
      "kind": "card",
      "refersTo": "console-panel",
      "description": "Solid panel with a 1dp cold edge light (ink at 55% when it belongs to a tool); hosts setup, info, About, progress and report.",
      "html": "<div class=\"ds-panel\"><div class=\"ds-panel-title\">Xbox XISO</div><p class=\"ds-panel-body\">Trim Redump Xbox ISOs to XISO for Hakux and xemu.</p><hr class=\"ds-rule\"><div class=\"ds-fmt\"><span>Reads</span><b>Redump .iso</b></div><div class=\"ds-fmt\"><span>Writes</span><b class=\"ds-ink\">XISO .iso</b></div></div>",
      "css": ".ds-panel{font-family:'Rubik',system-ui,sans-serif;background:#111934;border:1px solid rgba(74,222,128,.55);border-radius:16px;padding:18px;color:#E8EEFF;display:flex;flex-direction:column;gap:10px;max-width:420px;}.ds-panel-title{font-size:28px;font-weight:700;line-height:32px;letter-spacing:-.01em;}.ds-panel-body{margin:0;font-size:14px;line-height:20px;color:#9AA7CB;}.ds-rule{border:none;height:1px;background:#1B2650;margin:2px 0;width:100%;}.ds-fmt{display:flex;gap:12px;align-items:center;}.ds-fmt span{width:64px;font-size:14px;font-weight:600;color:#9AA7CB;}.ds-fmt b{font-size:16px;font-weight:600;}.ds-ink{color:#4ADE80;}"
    },
    {
      "name": "Data Row with Size Bar",
      "kind": "custom",
      "refersTo": "data-row",
      "description": "A file-list entry in the data pane: checkbox, title, block-meter size bar, target name, tabular size; amber line when output will be replaced.",
      "html": "<label class=\"ds-row ds-row-on\"><input type=\"checkbox\" checked><span class=\"ds-row-main\"><span class=\"ds-row-title\">Halo 2 (USA)</span><span class=\"ds-meter\"><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i></i><i></i><i></i><i></i><i></i></span><span class=\"ds-row-sub\">Halo 2 (USA).iso</span><span class=\"ds-row-warn\">Existing output will be replaced</span></span><span class=\"ds-row-size\">7.3 GB</span></label>",
      "css": ".ds-row{font-family:'Rubik',system-ui,sans-serif;display:flex;align-items:center;gap:12px;min-height:56px;padding:8px 12px;border-radius:12px;background:#111934;color:#E8EEFF;max-width:520px;}.ds-row-on{background:rgba(74,222,128,.10);}.ds-row:focus-within{outline:3px solid #4ADE80;}.ds-row input{accent-color:#4ADE80;width:18px;height:18px;}.ds-row-main{flex:1;display:flex;flex-direction:column;gap:3px;}.ds-row-title{font-size:16px;font-weight:600;}.ds-row-sub{font-size:12px;color:#9AA7CB;}.ds-row-warn{font-size:12px;color:#FFB347;}.ds-row-size{font-size:14px;font-weight:600;color:#9AA7CB;font-feature-settings:'tnum';}.ds-meter{display:flex;gap:3px;width:160px;height:5px;}.ds-meter i{flex:1;border-radius:2px;background:#1B2650;}.ds-meter i.on{background:#4ADE80;}"
    },
    {
      "name": "Choice Chips",
      "kind": "chip",
      "refersTo": "choice-chip",
      "description": "Mutually exclusive options; selected takes the ink fill. Entering the row with a controller lands on the current choice.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip ds-chip-on\">ES-DE</button><button class=\"ds-chip\">Other</button></div>",
      "css": ".ds-chips{display:flex;gap:8px;flex-wrap:wrap;}.ds-chip{font-family:'Rubik',system-ui,sans-serif;font-size:14px;font-weight:600;padding:8px 16px;border-radius:9999px;background:#18224A;color:#E8EEFF;border:1px solid rgba(127,167,255,.55);}.ds-chip-on{background:#FF8A3D;color:#05070D;border-color:#FF8A3D;}.ds-chip:focus-visible{outline:3px solid #FF8A3D;outline-offset:2px;}"
    },
    {
      "name": "Status Line",
      "kind": "custom",
      "refersTo": "status-line",
      "description": "Info in the ink at 12%, failures in the error role at 12%; never amber.",
      "html": "<div class=\"ds-status\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#FF7A7A\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v6M12 16.5v.5\"/></svg><span>Storage is low: 1.2 GB free, 7.3 GB needed.</span></div>",
      "css": ".ds-status{font-family:'Rubik',system-ui,sans-serif;display:flex;gap:10px;align-items:flex-start;padding:10px 12px;border-radius:12px;background:rgba(255,122,122,.12);color:#E8EEFF;font-size:14px;line-height:20px;max-width:520px;}"
    }
  ],
  "narrative": {
    "northStar": "The Memory Card Manager",
    "overview": "Mimir is drawn as a console's own system data browser. The tools are save blocks sitting in two memory-card slots on a night-blue field ruled with faint slot gridlines; a tool page is the card's data view, with what to read on the left and the files Mimir found, as file entries with block-meter size bars, on the right. Writing anything is a ceremony the console would recognise: a plain dialog, a named count, an amber button only when the write cannot be taken back.\n\nThe world is controller-first on a 1920x1080 handheld and touch-second. Every screen carries a header strip on top and a face-button legend bar at the foot; the legend is the literal map of what A, B, X and Y do here, and its entries are touch targets too. Each of the nine tools owns one ink and speaks in it everywhere on its page.\n\nThere are two lighting states of the same world, night (default) and daylight, and every token comes in both.",
    "keyCharacteristics": [
      "Night-blue field with a 48dp slot grid over a vertical fade; solid panels with a 1dp cold edge light.",
      "One ink per tool, with a night value and a darker daylight value.",
      "Tools are drawn objects, never icon-font tiles.",
      "Drawn A/B/X/Y face-button glyphs.",
      "One turning object at a time: the focused save block.",
      "Rubik throughout; rank by weight and reversal; tabular figures for every number."
    ],
    "rules": [
      {
        "name": "The Amber Is A Warning Rule",
        "body": "Amber appears only on a control that destroys or replaces data, or on the line warning that it will. Errors use the error role.",
        "section": "colors"
      },
      {
        "name": "The One Ink Per Page Rule",
        "body": "A tool page speaks only in its own ink plus the cold edge light for system chrome.",
        "section": "colors"
      },
      {
        "name": "The Paired Lighting Rule",
        "body": "Every colour exists as a night and a daylight value.",
        "section": "colors"
      },
      {
        "name": "The Sentence Case Rule",
        "body": "Buttons, legend labels, chips and titles are sentence case; only file-extension badges are uppercase, as data.",
        "section": "typography"
      },
      {
        "name": "The Tabular Figures Rule",
        "body": "Any number that can change or be compared is set with tnum.",
        "section": "typography"
      },
      {
        "name": "The No Kicker Rule",
        "body": "No eyebrow or kicker text above headings.",
        "section": "typography"
      },
      {
        "name": "The Two Pane Rule",
        "body": "A tool page is always setup on the left, data on the right on wide screens.",
        "section": "layout"
      },
      {
        "name": "The Lift Not Shadow Rule",
        "body": "Focus raises an element with scale and a bouncy settle; nothing gets a drop shadow to show state.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do give every new tool exactly one ink with a night and a darker daylight value, and its own drawn object.",
      "Do show focus with a 3dp ink ring and the focus lift; on night, filled buttons may also brighten.",
      "Do route every face-button action through the legend.",
      "Do confirm every write in a dialog that names the count, destructive confirm in caution amber, Cancel outlined.",
      "Do park all looping motion when the animation scale is 0.",
      "Do keep exactly one object turning at a time: the focused save block."
    ],
    "donts": [
      "Don't show focus by dimming or darkening an element.",
      "Don't use amber for errors, highlights or anything that can be undone.",
      "Don't represent a tool with an icon-font glyph or a Material icon tile.",
      "Don't add eyebrow or kicker text above headings, or uppercase labels.",
      "Don't stack Material cards in one scrolling column on a wide screen.",
      "Don't draw progress as a continuous bar; use the block meter.",
      "Don't let a text field open the keyboard just because a controller passed over it."
    ]
  }
}